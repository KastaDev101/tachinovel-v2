# https://editorconfig.org — matches the existing code; LF everywhere (see .gitattributes).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.swift]
indent_size = 4

[*.{plist,xcprivacy,entitlements,pbxproj}]
indent_style = tab

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

# Generated or third-party files: leave as they are.
[{vendor/**,ios/App/CapApp-SPM/**,package-lock.json}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
