{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // v1 sources are imported through this alias. Typecheck always uses the vendored snapshot;
    // the build can point the alias at a live v1 checkout instead (V1_ROOT, see tools/v1.ts).
    "paths": { "@v1/*": ["./vendor/v1/src/*"], "@v1tts/*": ["./vendor/v1/experiments/tts/*"] }
  }
}
