{
  "name": "tachinovel-v2",
  "version": "2.0.0-alpha.7",
  "private": true,
  "description": "TachiNovel v2: native iOS shell (Capacitor) around the v1 UI and script core. Evaluation scaffold, not released.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node tools/build.ts",
    "build:personal": "node tools/build.ts --flavor=personal",
    "build:store": "node tools/build.ts --flavor=store",
    "typecheck": "node tools/typecheck.ts",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test && node tools/ios-project.ts --check",
    "vendor:v1": "node tools/vendor-v1.ts",
    "cap:sync": "npm run build && npx cap sync ios",
    "cap:copy": "npm run build && npx cap copy ios",
    "test:shell": "vitest run --config vitest.shell.config.ts",
    "crawl": "node tools/ui-crawler.ts",
    "ios:project": "node tools/ios-project.ts",
    "revenue": "node tools/revenue-model.ts",
    "release:prepare": "node tools/release.ts prepare"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@preact/signals": "^2.11.3",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "htmlparser2": "^12.0.0",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "playwright-core": "1.63.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
