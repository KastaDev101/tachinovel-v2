<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App-level privacy manifest: the required-reason APIs the app target's own Swift code calls
	     (https://developer.apple.com/documentation/bundleresources/describing-use-of-required-reason-api).
	     Capacitor and its Cordova layer ship their own manifests inside their frameworks.
	     tests/privacy-manifest.test.ts scans ios/App/App/**/*.swift and fails when a required-reason API is
	     used without a declaration here, or declared without being used.

	     Tracking and collected data: none. The developer runs no server; nothing leaves the device except
	     requests to the websites of sources the user adds, and files the user chooses to share (backups,
	     problem reports). This is the personal and the ad-free store build. An ads build must add the ad
	     network's data types and tracking domains (see docs/monetization.md "Privacy label"); the Google
	     Mobile Ads SDK ships its own manifest. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- FileManager attributes (size, modification date) for the core's fs.size / fs.modifiedAt, only
			     on files in the app's own container and its own iCloud container (C617.1). -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<!-- UserDefaults read and written only by this app (CA92.1): narration listening positions, the
			     audio folder bookmark, voice settings, debug-only smoke-test flags. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
